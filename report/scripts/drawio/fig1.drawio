<mxfile host="drawio" agent="make_fig1.py"><diagram id="fig1" name="Figure 1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;TASK&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#8A887F;fontSize=9.5;strokeWidth=1;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="110.0" height="44.0" as="geometry"/></mxCell><mxCell id="n3" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F1E1D;fontSize=11;strokeWidth=1;spacing=0;rounded=1;arcSize=14;fillColor=#FAF9F5;strokeColor=#E2DFD6;" vertex="1" parent="1"><mxGeometry x="120.0" y="0.0" width="680.0" height="44.0" as="geometry"/></mxCell><mxCell id="n4" value="Choose &lt;b&gt;JOIN&lt;/b&gt;: 10 points if the partner joins (probability &lt;font face=&quot;Cambria&quot;&gt;&lt;i&gt;p&lt;/i&gt;&lt;/font&gt;), otherwise 0; or &lt;b&gt;SAFE&lt;/b&gt;: &lt;font face=&quot;Cambria&quot;&gt;&lt;i&gt;s&lt;/i&gt;&lt;/font&gt; points for sure.&lt;br&gt;&lt;font color=&quot;#5E5D59&quot;&gt;&lt;font face=&quot;Cambria&quot;&gt;&lt;i&gt;q&lt;/i&gt;&lt;/font&gt;: a probability stated in the prompt that should not matter (an outdated prior; whether the partner received a message)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F1E1D;fontSize=10.5;strokeWidth=1;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="136.0" y="4.0" width="648.0" height="36.0" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;MODEL&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#8A887F;fontSize=9.5;strokeWidth=1;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0.0" y="58.0" width="110.0" height="74.0" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;TEST&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#8A887F;fontSize=9.5;strokeWidth=1;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0.0" y="150.0" width="110.0" height="112.0" as="geometry"/></mxCell><mxCell id="n7" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F1E1D;fontSize=11;strokeWidth=1;spacing=0;rounded=1;arcSize=10;fillColor=#EFECE3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="120.0" y="58.0" width="325.0" height="74.0" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;1&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#FFFFFF;fontSize=10;strokeWidth=1;spacing=0;shape=ellipse;fillColor=#1F1E1D;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="134.0" y="71.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Valuation&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F1E1D;fontSize=12.5;strokeWidth=1;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160.0" y="68.0" width="120.0" height="24.0" as="geometry"/></mxCell><mxCell id="n10" value="&lt;font face=&quot;Cambria&quot;&gt;&lt;i&gt;V&lt;/i&gt;&lt;/font&gt; = 10 · &lt;font face=&quot;Cambria&quot;&gt;&lt;i&gt;p&lt;/i&gt;&lt;/font&gt; · &lt;font face=&quot;Cambria&quot;&gt;&lt;i&gt;q&lt;/i&gt;&lt;/font&gt;&lt;sup&gt;&lt;font face=&quot;Cambria&quot;&gt;&lt;i&gt;κ&lt;/i&gt;&lt;/font&gt;&lt;/sup&gt;" style="html=1;whiteSpace=wrap;fontFamily=Cambria;fontColor=#1F1E1D;fontSize=15;strokeWidth=1;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="134.0" y="98.0" width="297.0" height="26.0" as="geometry"/></mxCell>